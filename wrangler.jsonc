// Cloudflare Worker for lingwaexplorers.com.
// The repo root is served as static files; .assetsignore keeps the repo's own
// files, src/ and play/ (index.wasm is over the 25 MiB per-file limit) out of
// the upload. src/worker.js only runs when no file matches: it handles the
// contact form and otherwise serves 404.html.
// The contact form needs a CONTACT_TO secret (a verified Email Routing
// destination), set in the dashboard: Worker > Settings > Variables and Secrets.
{
  "name": "lingwa-explorers",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // Only lingwaexplorers.com serves the site: no *.workers.dev or preview
  // copies for search engines to find as duplicates.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "send_email": [{ "name": "CONTACT" }],
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "lingwaexplorers.com", "custom_domain": true },
    { "pattern": "www.lingwaexplorers.com", "custom_domain": true }
  ]
}
